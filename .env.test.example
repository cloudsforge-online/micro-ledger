export LEDGER_DATABASE_URL='postgres://cloudsforge:CHANGE_ME@127.0.0.1:5432/ledger_test'
export LEDGER_TEST_DATABASE_URL='postgres://cloudsforge:CHANGE_ME@127.0.0.1:5432/ledger_test'
export IDENTITY_JWKS_URL='http://127.0.0.1:4401/.well-known/jwks.json'
export IDENTITY_ISSUER='https://identity.cloudsforge.test'
# A real one, generated per shell. The boot guard (@cloudsforge/secrets) refuses anything
# that is not shaped like a generated secret, and a fixture that is exempt from the rule it
# is meant to exercise is how the placeholder in micro-org #142 survived every test.
export OUTBOX_SIGNING_SECRET="$(openssl rand -base64 48)"
export LEDGER_ASSET_TOLERANCE='{"EMBER":"1000000000000000","LTC":"0"}'
export LEDGER_RECONCILE_ASSETS='SHARD,EMBER'
export LEDGER_RECONCILE_NETWORK='testnet'
export LOG_LEVEL='warn'
