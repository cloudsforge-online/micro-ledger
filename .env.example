# The ledger's configuration. Every variable the service reads is declared in src/env.ts and
# appears here; nothing else is passed to the container (rule 9 of docs/ecosystem/03 §2).

PORT=4000
NODE_ENV=production
LOG_LEVEL=info
CLOUDSFORGE_TAG=dev

# Rule 1: one database, named by this service's own variable. The ledger shares a database with
# nothing — AD-06 and AD-17 put it on the `vault` network with custody and settlement.
LEDGER_DATABASE_URL=postgres://cloudsforge:CHANGE_ME@postgres:5432/ledger
LEDGER_DATABASE_POOL_MAX=10

# Service tokens are RS256, issued by identity, and carry `ledger:post`, `ledger:read` and
# `ledger:reserve`. The shared PAY_SERVICE_TOKEN is retired — AD-17.
IDENTITY_JWKS_URL=http://identity:4000/.well-known/jwks.json
IDENTITY_ISSUER=https://identity.cloudsforge.online

# HMAC key for outbound event signatures. At least 32 random characters; a placeholder is refused
# at boot rather than accepted and forged later.
OUTBOX_SIGNING_SECRET=CHANGE_ME_TO_32_RANDOM_CHARACTERS

# Reconciliation. Per-asset drift tolerance in SMALLEST UNITS, as a JSON object of strings.
#
# An asset absent from this map gets ZERO tolerance, not unlimited — `withinTolerance` in
# contracts-money fails closed, and that is deliberate: an asset silently exempt from the only
# check that guards it is worse than an asset that alerts too often. The example below allows
# 0.001 EMBER (18 decimals) of fees in flight.
LEDGER_ASSET_TOLERANCE={"EMBER":"1000000000000000"}
LEDGER_RECONCILE_ASSETS=SHARD,EMBER
LEDGER_RECONCILE_NETWORK=testnet

# The chain half of the solvency invariant: GET /v1/custody/:chain/:network/total on micro-indexer.
#
# OPTIONAL, AND UNSET IS NOT A DISABLED CHECK — IT IS A FAILING ONE. Without a URL no chain asset
# can be observed, so every ON_CHAIN_ASSETS member records `unavailable`/`failed` and freezes
# withdrawals. It is optional only because src/migrator.ts shares this env module and the migrate
# container is given no indexer; demanding one would kill it and take the estate's schema with it.
# The service logs a fatal line at boot naming the assets it is about to freeze.
INDEXER_URL=http://indexer:4000

# Absolute ceiling on that call, across connect and body. It bounds a JOB'S LEASE as much as a
# request: the reconciliation handler holds its lease for the whole call, so a provider holding the
# socket open blocks the asset's next sweep. Integer 100–60000.
LEDGER_INDEXER_DEADLINE_MS=5000

# The credential presented to the indexer. The custody route is the one read on that service which
# demands `indexer:read`, because it answers a question about a set only the platform knows — the
# size of the estate's custody position — rather than about a block anyone can fetch.
#
# UNSET IS A SUPPORTED MODE and it fails closed: the call 401s, the 401 maps to no observation, and
# the asset freezes. It is left empty here on purpose rather than given a placeholder, because a
# placeholder that boots is how a secret from a repository reaches production. The grant is DERIVED
# from `INDEXER_SCOPES` in src/indexerclient.ts by deploy/scripts/derive-grants.mjs; a grant added
# by hand to the compose file fails that check.
LEDGER_SERVICE_TOKEN=

# How long an idempotency key is honoured. Expiring one EARLY means the next replay of it does the
# work a second time, so this must outlive every caller's retry horizon.
LEDGER_IDEMPOTENCY_TTL_DAYS=30

# Names this replica in jobs.locked_by. Defaults to the hostname, which is the container id under
# compose and the pod name under Kubernetes.
# INSTANCE_ID=

# Database tests run only against a database whose name contains "test", because they truncate.
# Unset, every database test skips.
# LEDGER_TEST_DATABASE_URL=postgres://cloudsforge:CHANGE_ME@127.0.0.1:5432/ledger_test
